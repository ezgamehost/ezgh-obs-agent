{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster",
    "ezgh",
    "auth",
    "image",
    "imagePullSecrets",
    "logs",
    "metrics",
    "traces",
    "clusterState",
    "kubernetesMetadata",
    "otlp",
    "export",
    "storage",
    "resources",
    "memoryLimiter",
    "nodeSelector",
    "tolerations",
    "affinity",
    "priorityClassName",
    "podAnnotations",
    "terminationGracePeriodSeconds"
  ],
  "properties": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "uid"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "uid": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "ezgh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "endpoint"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.:-]*/?$"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "secretKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          }
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "collectContainerLogs",
        "parseSeverity",
        "startAt",
        "excludeNamespaces",
        "exclude",
        "maxLogSize"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collectContainerLogs": {
          "type": "boolean"
        },
        "parseSeverity": {
          "type": "boolean"
        },
        "startAt": {
          "type": "string",
          "enum": [
            "beginning",
            "end"
          ]
        },
        "excludeNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxLogSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(KiB|MiB)$"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "collectKubeletMetrics",
        "collectionInterval",
        "kubelet"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collectKubeletMetrics": {
          "type": "boolean"
        },
        "collectionInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m)$"
        },
        "kubelet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "insecureSkipVerify",
            "caConfigMap",
            "caKey",
            "podSpecs"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https://.+"
            },
            "insecureSkipVerify": {
              "type": "boolean"
            },
            "caConfigMap": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([a-z0-9.-]*[a-z0-9])?)?$"
            },
            "caKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "podSpecs": {
              "enum": [
                "auto",
                true,
                false
              ]
            }
          }
        }
      }
    },
    "traces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "clusterState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "collectionInterval",
        "resources",
        "memoryLimiter",
        "nodeSelector",
        "tolerations",
        "affinity",
        "priorityClassName"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collectionInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m)$"
        },
        "resources": {
          "type": "object"
        },
        "memoryLimiter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limitMiB",
            "spikeLimitMiB"
          ],
          "properties": {
            "limitMiB": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "spikeLimitMiB": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        }
      }
    },
    "kubernetesMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "otlp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internalTrafficPolicy"
      ],
      "properties": {
        "internalTrafficPolicy": {
          "type": "string",
          "enum": [
            "Cluster",
            "Local"
          ]
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queueSizeMiB",
        "storageMaxMiB",
        "numConsumers",
        "timeout"
      ],
      "properties": {
        "queueSizeMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "storageMaxMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "numConsumers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "timeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m)$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostPath"
      ],
      "properties": {
        "hostPath": {
          "type": "string",
          "pattern": "^/[^\\s]*[^/\\s]$"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "memoryLimiter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limitMiB",
        "spikeLimitMiB"
      ],
      "properties": {
        "limitMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "spikeLimitMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  },
  "$schema": "https://json-schema.org/draft-07/schema#"
}
